# Copy to .env and edit. .env is git-ignored; .env.example is the documentation.
# `pnpm run doctor` loads .env automatically. Variables already set in your shell take priority.

# Where the Ollama server listens. Optional: the default is http://127.0.0.1:11434.
# Accepts "host", "host:port" or a full URL; the port defaults to 11434.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: use another config file instead of rag.config.json.
# RAG_CONFIG=evals/experiments/small-chunks.json

# Optional: override any config setting as RAG_<SECTION>__<KEY> (see docs/architecture.md).
# RAG_CHUNKING__MAX_TOKENS=300
# RAG_GENERATION__MODEL=llama3.2
